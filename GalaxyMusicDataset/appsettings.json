    "CrossProviderMatchSeconds": 2,
    "SeedSampleData": false,
    "EnableMusicBrainz": true,
    "EnableLastFmTrackInfo": true,
    "EnableMalojaAlbumArt": true,
    "EnableDiscogs": true,
    "EnableTheAudioDb": true,
    "EnableVocaDb": true,
    "EnableUtaiteDb": true,
    "EnableTouhouDb": true,
    "EnableVgmdb": true,
    "AutoMatchThreshold": 0.92,
    "ReviewThreshold": 0.55
  }
