{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LastFm": {
    "ApiKey": "",
    "Username": "",
    "UserAgent": "GalaxyMusicDataset/0.1 (https://github.com/elijahjero/galaxymusicdataset)"
  },
  "MusicBrainz": {
    "UserAgent": "GalaxyMusicDataset/0.1",
    "Contact": "https://github.com/elijahjero/galaxymusicdataset",
    "BaseUrl": "https://musicbrainz.org",
    "CoverArtBaseUrl": "https://coverartarchive.org"
  },
  "Discogs": {
    "Token": "",
    "UserAgent": "GalaxyMusicDataset/0.1 +https://github.com/elijahjero/galaxymusicdataset"
  },
  "TheAudioDb": {
    "ApiKey": ""
  },
  "VocaDb": {
    "BaseUrl": "https://vocadb.net"
  },
  "UtaiteDb": {
    "BaseUrl": "https://utaitedb.net"
  },
  "TouhouDb": {
    "BaseUrl": "https://touhoudb.com"
  },
  "Aggregation": {
    "IncrementalIntervalMinutes": 60,
    "OverlapSeconds": 300,
    "LastFmPageSize": 200,
    "SeedSampleData": false,
    "EnableMusicBrainz": true,
    "EnableLastFmTrackInfo": true,
    "EnableDiscogs": true,
    "EnableTheAudioDb": true,
    "EnableVocaDb": true,
    "EnableUtaiteDb": true,
    "EnableTouhouDb": true,
    "AutoMatchThreshold": 0.92,
    "ReviewThreshold": 0.55
  }
}
