@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<h1 class="h3">Admin login</h1>
<p class="text-muted">Analytics are public. Sign in to manage ingest, review matches, and edit settings.</p>

@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (!Model.IsConfigured)
{
    <div class="alert alert-warning">Set <code>Auth:Password</code> or <code>AUTH_PASSWORD</code> to enable admin sign-in.</div>
}

<form method="post" class="card card-body" style="max-width: 24rem;" autocomplete="username">
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
    <div class="mb-3">
        <label class="form-label" asp-for="Username">Username</label>
        <input class="form-control" asp-for="Username" autocomplete="username" autofocus />
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Password">Password</label>
        <input class="form-control" asp-for="Password" type="password" autocomplete="current-password" />
    </div>
    <button class="btn btn-primary" type="submit" disabled="@(!Model.IsConfigured)">Sign in</button>
</form>
