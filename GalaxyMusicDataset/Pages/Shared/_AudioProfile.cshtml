@model global::GalaxyMusicDataset.Services.Audio.AudioProfileView
@{
    var audio = Model;
    string Bar(double? value)
    {
        var pct = Math.Clamp((value ?? 0) * 100, 0, 100);
        return pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    }

    var meters = new List<KeyValuePair<string, double?>>
    {
        new("Danceability", audio.Danceability),
        new("Voice", audio.Voice),
        new("Acoustic", audio.Acoustic),
        new("Electronic", audio.Electronic),
        new("Approachability", audio.Approachability),
        new("Engagement", audio.Engagement),
        new("Party", audio.MoodParty),
        new("Happy", audio.MoodHappy),
        new("Aggressive", audio.MoodAggressive),
        new("Relaxed", audio.MoodRelaxed),
        new("Sad", audio.MoodSad)
    };
}

<div class="card mb-4">
    <div class="card-header">Audio profile (Essentia)</div>
    <div class="card-body">
        <p class="small text-muted">Classifier output from a local Essentia client. These are not crowd or database tags.</p>
        <dl class="row small mb-3">
            <dt class="col-sm-3">BPM / key</dt>
            <dd class="col-sm-9">
                @if (audio.Bpm is double bpm)
                {
                    var bucket = AudioBpm.Bucket(bpm);
                    var bpmRoutes = new Dictionary<string, string?> { ["kind"] = "bpm", ["name"] = bucket.Slug };
                    <a asp-page="/AudioProfiles" asp-all-route-data="bpmRoutes">@bpm.ToString("0.##")</a>
                }
                else
                {
                    <text>—</text>
                }
                <text> · </text>
                @if (!string.IsNullOrWhiteSpace(audio.KeyDisplay))
                {
                    var keyRoutes = new Dictionary<string, string?> { ["kind"] = "key", ["name"] = audio.KeyDisplay };
                    <a asp-page="/AudioProfiles" asp-all-route-data="keyRoutes">@audio.KeyDisplay</a>
                }
                else
                {
                    <text>—</text>
                }
                @if (audio.KeyStrength is double ks)
                {
                    <span> (strength @ks.ToString("0.00"))</span>
                }
            </dd>
            <dt class="col-sm-3">Timbre</dt>
            <dd class="col-sm-9">@(audio.Timbre ?? "—")</dd>
            @if (audio.Loudness is not null)
            {
                <dt class="col-sm-3">Loudness</dt>
                <dd class="col-sm-9">@audio.Loudness.Value.ToString("0.###")</dd>
            }
            <dt class="col-sm-3">Analyzed</dt>
            <dd class="col-sm-9">@AnalyticsDisplay.Timestamp(audio.AnalyzedAt)</dd>
        </dl>

        <div class="row g-2 mb-3">
            @foreach (var meter in meters)
            {
                <div class="col-md-6">
                    <div class="d-flex justify-content-between small">
                        <span>@meter.Key</span>
                        <span>@(meter.Value?.ToString("0.00") ?? "—")</span>
                    </div>
                    <div class="progress" style="height:6px;">
                        <div class="progress-bar" style="width:@Bar(meter.Value)%"></div>
                    </div>
                </div>
            }
        </div>

        <div class="small mb-1 text-muted">Genres</div>
        <div class="mb-2">
            @foreach (var genre in audio.Genres)
            {
                <partial name="_AudioLabelLink" model='new AudioLabelLinkModel(genre.Name, AudioLabelKind.Genre, new Dictionary<string, string?>(), genre.Score?.ToString("0.00"))' />
            }
        </div>
        <div class="small mb-1 text-muted">Themes</div>
        <div class="mb-2">
            @foreach (var theme in audio.Themes)
            {
                <partial name="_AudioLabelLink" model='new AudioLabelLinkModel(theme.Name, AudioLabelKind.Theme, new Dictionary<string, string?>(), theme.Score?.ToString("0.00"), null, "audio-chip-theme")' />
            }
        </div>
        <div class="small mb-1 text-muted">Instruments</div>
        <div>
            @foreach (var inst in audio.Instruments)
            {
                <partial name="_AudioLabelLink" model='new AudioLabelLinkModel(inst.Name, AudioLabelKind.Instrument, new Dictionary<string, string?>(), inst.Score?.ToString("0.00"), null, "audio-chip-instrument")' />
            }
        </div>
    </div>
</div>
