@model RecentModel

<nav>
    <ul class="pagination pagination-sm mb-0">
        <li class="page-item @(Model.P <= 1 ? "disabled" : "")">
            <a class="page-link" asp-page="/Recent" asp-all-route-data="Model.FilterRoutes(page: Model.P - 1)">Prev</a>
        </li>
        <li class="page-item disabled"><span class="page-link">@Model.P / @Model.TotalPages</span></li>
        <li class="page-item @(Model.P >= Model.TotalPages ? "disabled" : "")">
            <a class="page-link" asp-page="/Recent" asp-all-route-data="Model.FilterRoutes(page: Model.P + 1)">Next</a>
        </li>
    </ul>
</nav>
