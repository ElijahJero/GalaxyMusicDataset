@model HeatmapResult
@{
    var map = Model.Cells.ToDictionary(c => (c.WeekdayMonday0, c.HourUtc));
    var days = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
    var max = Math.Max(1, Model.MaxCount);
}

<div class="heatmap-wrap">
    <div class="heatmap" role="img" aria-label="Scrobble heatmap by weekday and hour UTC">
        <div class="heatmap-corner"></div>
        @for (var hour = 0; hour < 24; hour++)
        {
            <div class="heatmap-hour">@hour</div>
        }
        @for (var day = 0; day < 7; day++)
        {
            <div class="heatmap-day">@days[day]</div>
            @for (var hour = 0; hour < 24; hour++)
            {
                map.TryGetValue((day, hour), out var cell);
                var count = cell?.Count ?? 0;
                var level = count == 0 ? 0 : 0.15 + 0.85 * (count / (double)max);
                var title = $"{days[day]} {hour:00}:00 UTC — {count} scrobble{(count == 1 ? "" : "s")}";
                <div class="heatmap-cell" style="--level: @level.ToString(System.Globalization.CultureInfo.InvariantCulture)" title="@title"></div>
            }
        }
    </div>
    <div class="small text-muted mt-2">Hours in UTC. Darker cells have more scrobbles.</div>
</div>
