@model global::GalaxyMusicDataset.Services.Audio.AudioProfileView
@{
    var audio = Model;
    var summaryLine = (audio.Summary ?? "").Split('\n')[0];
    var filter = new Dictionary<string, string?>();
}

<div class="audio-profile">
    <div class="small text-muted mb-1">Essentia (client)</div>
    @if (!string.IsNullOrWhiteSpace(summaryLine))
    {
        <div class="small">@summaryLine</div>
    }
    <div class="mt-1">
        @foreach (var genre in audio.Genres)
        {
            <partial name="_AudioLabelLink" model='new AudioLabelLinkModel(genre.Name, AudioLabelKind.Genre, filter)' />
        }
        @foreach (var theme in audio.Themes.Take(5))
        {
            <partial name="_AudioLabelLink" model='new AudioLabelLinkModel(theme.Name, AudioLabelKind.Theme, filter, null, null, "audio-chip-theme")' />
        }
        @foreach (var inst in audio.Instruments.Take(5))
        {
            <partial name="_AudioLabelLink" model='new AudioLabelLinkModel(inst.Name, AudioLabelKind.Instrument, filter, null, null, "audio-chip-instrument")' />
        }
    </div>
</div>
