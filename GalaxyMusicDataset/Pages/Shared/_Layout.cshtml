<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Galaxy Music</title>
    <script>
        (() => {
            try {
                const theme = localStorage.getItem("galaxy-theme") || "dark";
                document.documentElement.setAttribute("data-bs-theme", theme);
            } catch { /* ignore */ }
        })();
    </script>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hud.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GalaxyMusicDataset.styles.css" asp-append-version="true" />
</head>
<body class="cockpit">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm hud-nav mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="@(User.Identity?.IsAuthenticated == true ? "/Index" : "/Dashboard")">
                    <span class="brand-mark" aria-hidden="true">GM</span>
                    <span class="brand-wordmark">Galaxy Music</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Index">Progress</a>
                            </li>
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Analytics</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-page="/Dashboard">Overview</a></li>
                                <li><a class="dropdown-item" asp-page="/Tops">Tops</a></li>
                                <li><a class="dropdown-item" asp-page="/Tags">Genres</a></li>
                                <li><a class="dropdown-item" asp-page="/AudioProfiles">Audio</a></li>
                                <li><a class="dropdown-item" asp-page="/Discovery">Discovery</a></li>
                                <li><a class="dropdown-item" asp-page="/Patterns">Patterns</a></li>
                                <li><a class="dropdown-item" asp-page="/DeepCuts">Deep cuts</a></li>
                                <li><a class="dropdown-item" asp-page="/Sessions">Sessions</a></li>
                            </ul>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Recent">Library</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Lookups">Lookups</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Review">Review</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Settings">Settings</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form method="post" asp-page="/Logout" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Logout</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-page="/Login">Login</a>
                        }
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-theme-toggle aria-pressed="true" title="Toggle color theme">Light</button>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container hud-stage">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer hud-footer">
        <div class="container">
            &copy; 2026 - Galaxy Music - <a asp-area="" asp-page="/Api">API</a> - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
