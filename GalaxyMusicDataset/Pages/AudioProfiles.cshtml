@page "/Audio"
@model AudioProfilesModel
@{
    ViewData["Title"] = Model.Detail is null ? "Audio profile" : Model.Detail.Name;
}

<h1 class="h3 mb-1">@(Model.Detail?.Name ?? "Audio profile")</h1>
<p class="text-muted">
    Play-weighted Essentia features from a local client. Classifier genres use Discogs-style folders
    (primary / subgenre), so you can open everything Electronic or just Electronic/Synth-pop.
    Click a BPM range or key to list matching recordings the same way.
</p>

<partial name="_AnalyticsNav" model='"audio"' />
<partial name="_TimeRange" model='Model.TimeRangeView("/AudioProfiles", Model.Extra())' />

@if (Model.Detail is not null)
{
    <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
        <a class="btn btn-sm btn-outline-secondary" asp-page="/AudioProfiles" asp-all-route-data="Model.FilterQuery()">All audio labels</a>
        @if (Model.Detail.Parent is not null)
        {
            var parentRoutes = Model.AudioLabelQuery(AudioLabelKind.Genre, Model.Detail.Parent);
            <a class="btn btn-sm btn-outline-secondary" asp-page="/AudioProfiles" asp-all-route-data="parentRoutes">@Model.Detail.Parent</a>
        }
        <a class="btn btn-sm btn-outline-primary" asp-page="/Recent" asp-all-route-data="Model.LibraryFilterForDetail()">All recordings in library</a>
        <span class="small text-muted">@Model.Detail.Kind · @Model.DetailKindLabel</span>
    </div>

    @if (Model.Detail.Children.Count > 0)
    {
        <div class="card mb-4">
            <div class="card-header">Subgenres of @Model.Detail.Name</div>
            <partial name="_AudioGenreTree" model='new AudioGenreTreeModel(Model.Detail.Children, Model.FilterQuery(), Model.Detail.Path)' />
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">Tracks</div>
                <partial name="_TopTable" model='new TopTableModel(Model.Detail.Tracks, Model.FilterQuery(), "Track", "/Tracks", false)' />
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">Artists</div>
                <partial name="_TopTable" model='new TopTableModel(Model.Detail.Artists, Model.FilterQuery(), "Artist", "/Artists", false)' />
            </div>
        </div>
    </div>
}

@if (Model.Audio.ProfiledPlays == 0)
{
    <div class="alert alert-info">
        No Essentia profiles in this range yet. Run the local client against
        <code>GET /api/v1/tracks/pending-audio</code> with a write API key.
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Profiled plays</div>
                <div class="fs-3">@AnalyticsDisplay.Count(Model.Audio.ProfiledPlays)</div>
                <div class="small text-muted">@AnalyticsDisplay.Percent(Model.Audio.PercentProfiledPlays) of plays</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Mean BPM</div>
                <div class="fs-3">@(Model.Audio.MeanBpm?.ToString("0") ?? "—")</div>
                <div class="small text-muted">@AnalyticsDisplay.Count(Model.Audio.ProfiledTracks) tracks</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Danceability</div>
                <div class="fs-3">@(Model.Audio.MeanDanceability?.ToString("0.00") ?? "—")</div>
                <div class="small text-muted">voice @(Model.Audio.MeanVoice?.ToString("0.00") ?? "—")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Top mood</div>
                <div class="fs-3 text-capitalize">@(Model.Audio.TopMood ?? "—")</div>
                <div class="small text-muted">play-weighted</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">BPM</div>
            <div class="card-body">
                @if (Model.Audio.BpmBuckets.Count == 0)
                {
                    <div class="text-muted">No BPM values yet.</div>
                }
                else
                {
                    <div class="audio-chart">
                        <canvas height="180" data-chart="audio-bars" data-payload="@Model.BpmJson"></canvas>
                    </div>
                    <p class="small text-muted mb-2 mt-3">Click a range to list recordings, the same way as a genre folder.</p>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                            <tr><th>BPM</th><th class="text-end">Plays</th><th class="text-end">Tracks</th></tr>
                            </thead>
                            <tbody>
                            @foreach (var row in Model.Audio.BpmBuckets)
                            {
                                var slug = AudioBpm.Find(row.Name)?.Slug ?? row.Name;
                                var routes = Model.AudioFeatureQuery("bpm", slug);
                                var active = string.Equals(Model.Detail?.Path, slug, StringComparison.OrdinalIgnoreCase);
                                <tr class="@(active ? "audio-genre-active" : null)">
                                    <td><a asp-page="/AudioProfiles" asp-all-route-data="routes">@row.Name</a></td>
                                    <td class="text-end">@AnalyticsDisplay.Count(row.Plays)</td>
                                    <td class="text-end">@AnalyticsDisplay.Count(row.Count)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Key</div>
            <div class="card-body">
                @if (Model.Audio.Keys.Count == 0)
                {
                    <div class="text-muted">No keys yet.</div>
                }
                else
                {
                    <div class="audio-chart">
                        <canvas height="180" data-chart="genres" data-payload="@Model.KeyJson"></canvas>
                    </div>
                    <p class="small text-muted mb-2 mt-3">Click a key to list recordings in that key and scale.</p>
                    <div class="table-responsive hud-scroll-panel">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                            <tr><th>Key</th><th class="text-end">Plays</th><th class="text-end">Tracks</th></tr>
                            </thead>
                            <tbody>
                            @foreach (var row in Model.Audio.Keys)
                            {
                                var routes = Model.AudioFeatureQuery("key", row.Name);
                                var active = string.Equals(Model.Detail?.Path, row.Name, StringComparison.OrdinalIgnoreCase);
                                <tr class="@(active ? "audio-genre-active" : null)">
                                    <td><a asp-page="/AudioProfiles" asp-all-route-data="routes">@row.Name</a></td>
                                    <td class="text-end">@AnalyticsDisplay.Count(row.Plays)</td>
                                    <td class="text-end">@AnalyticsDisplay.Count(row.Count)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Moods</div>
            <div class="card-body">
                @if (Model.Audio.MoodAverages.Count == 0)
                {
                    <div class="text-muted">No mood scores yet.</div>
                }
                else
                {
                    <canvas height="180" data-chart="audio-bars" data-payload="@Model.MoodJson"></canvas>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Primary genres</div>
            <div class="card-body">
                @if (Model.Audio.Genres.Count == 0)
                {
                    <div class="text-muted">No audio genres yet.</div>
                }
                else
                {
                    <canvas height="180" data-chart="genres" data-payload="@Model.GenreJson"></canvas>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">Essentia genres</div>
    <p class="small text-muted px-3 pt-3 mb-0">
        Click a primary folder to see every recording in that family, or a subgenre for the leaf.
    </p>
    <partial name="_AudioGenreTree" model='new AudioGenreTreeModel(Model.Audio.GenreFolders, Model.FilterQuery(), Model.Detail?.Path)' />
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">Themes</div>
            @if (Model.Audio.Themes.Count == 0)
            {
                <div class="card-body text-muted">Nothing to list.</div>
            }
            else
            {
                <div class="table-responsive hud-scroll-panel">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                        <tr><th>Theme</th><th class="text-end">Plays</th><th class="text-end">Tracks</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.Audio.Themes)
                        {
                            var routes = Model.AudioLabelQuery(AudioLabelKind.Theme, row.Name);
                            <tr>
                                <td><a asp-page="/AudioProfiles" asp-all-route-data="routes">@row.Name</a></td>
                                <td class="text-end">@AnalyticsDisplay.Count(row.Plays)</td>
                                <td class="text-end">@AnalyticsDisplay.Count(row.TrackCount)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">Instruments</div>
            @if (Model.Audio.Instruments.Count == 0)
            {
                <div class="card-body text-muted">Nothing to list.</div>
            }
            else
            {
                <div class="table-responsive hud-scroll-panel">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                        <tr><th>Instrument</th><th class="text-end">Plays</th><th class="text-end">Tracks</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.Audio.Instruments)
                        {
                            var routes = Model.AudioLabelQuery(AudioLabelKind.Instrument, row.Name);
                            <tr>
                                <td><a asp-page="/AudioProfiles" asp-all-route-data="routes">@row.Name</a></td>
                                <td class="text-end">@AnalyticsDisplay.Count(row.Plays)</td>
                                <td class="text-end">@AnalyticsDisplay.Count(row.TrackCount)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/analytics.js" asp-append-version="true"></script>
}
