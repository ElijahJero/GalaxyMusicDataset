@page
@model ReviewModel
@{
    ViewData["Title"] = "Review queue";
}

<h1 class="h3">MusicBrainz review queue</h1>
<p class="text-muted">Candidates that did not meet the auto-match threshold. Accept a hit, mark as not in MusicBrainz, or retry the search.</p>

@if (Model.Rows.Count == 0)
{
    <div class="alert alert-success">Nothing to review.</div>
}

@foreach (var row in Model.Rows)
{
    var lookup = row.Lookup;
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between flex-wrap gap-2">
                <div>
                    <div class="fs-5">@lookup.ArtistName — @lookup.TrackName</div>
                    <div class="text-muted">@(lookup.AlbumName ?? "no album") · best @(lookup.BestScore?.ToString("0.00") ?? "—")</div>
                </div>
                <form method="post" class="d-flex gap-2">
                    <input type="hidden" name="id" value="@lookup.Id" />
                    <button class="btn btn-sm btn-outline-secondary" asp-page-handler="Retry">Retry search</button>
                    <button class="btn btn-sm btn-outline-danger" asp-page-handler="NotFound">Not in MusicBrainz</button>
                </form>
            </div>
            @if (row.Candidates.Count == 0)
            {
                <p class="mt-3 mb-0 text-muted">No cached candidates.</p>
            }
            else
            {
                <table class="table table-sm mt-3 mb-0">
                    <thead>
                    <tr><th>Score</th><th>Recording</th><th>MBID</th><th></th></tr>
                    </thead>
                    <tbody>
                    @foreach (var c in row.Candidates)
                    {
                        <tr>
                            <td>@c.Score.ToString("0.00")</td>
                            <td>
                                <div>@c.Artist — @c.Title</div>
                                <div class="small text-muted">@(c.Album ?? "no release") @(c.LengthMs is null ? "" : $"· {c.LengthMs} ms") @(c.Disambiguation)</div>
                            </td>
                            <td><code>@c.Mbid</code></td>
                            <td>
                                <form method="post" asp-page-handler="Accept">
                                    <input type="hidden" name="id" value="@lookup.Id" />
                                    <input type="hidden" name="mbid" value="@c.Mbid" />
                                    <button class="btn btn-sm btn-primary">Accept</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
}
