@page
@model SettingsModel
@{
    ViewData["Title"] = "Settings";
}

<h1 class="h3">Aggregation settings</h1>
<p class="text-muted">Keys are stored in <code>App_Data/user-settings.json</code> (gitignored). Secret fields are never shown after save — leave them blank to keep the current value, or paste a new value to replace it. REST API keys for a mobile app are managed in the section below and stored hashed in <code>App_Data/api-keys.json</code>.</p>

@if (Model.Saved is not null)
{
    <div class="alert alert-success">@Model.Saved</div>
}

<form method="post" class="card card-body" autocomplete="off">
    <h2 class="h5">Last.fm</h2>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label" asp-for="Input.LastFmUsername">Username</label>
            <input class="form-control" asp-for="Input.LastFmUsername" />
        </div>
        <div class="col-md-6">
            <label class="form-label" asp-for="Input.LastFmApiKey">API key</label>
            <input class="form-control" asp-for="Input.LastFmApiKey" type="password" value="" autocomplete="new-password" placeholder="@(Model.LastFmKeySaved ? "Saved — leave blank to keep" : "")" />
            @if (Model.LastFmKeySaved)
            {
                <div class="form-text">A Last.fm API key is already saved.</div>
            }
        </div>
    </div>

    <h2 class="h5">Other APIs</h2>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label" asp-for="Input.DiscogsToken">Discogs token</label>
            <input class="form-control" asp-for="Input.DiscogsToken" type="password" value="" autocomplete="new-password" placeholder="@(Model.DiscogsTokenSaved ? "Saved — leave blank to keep" : "")" />
            @if (Model.DiscogsTokenSaved)
            {
                <div class="form-text">A Discogs token is already saved.</div>
            }
        </div>
        <div class="col-md-6">
            <label class="form-label" asp-for="Input.TheAudioDbApiKey">TheAudioDB API key</label>
            <input class="form-control" asp-for="Input.TheAudioDbApiKey" type="password" value="" autocomplete="new-password" placeholder="@(Model.TheAudioDbKeySaved ? "Saved — leave blank to keep" : "")" />
            @if (Model.TheAudioDbKeySaved)
            {
                <div class="form-text">A TheAudioDB key is already saved.</div>
            }
        </div>
    </div>

    <h2 class="h5">MusicBrainz</h2>
    <p class="text-muted small">Leave the server URL blank (or <code>https://musicbrainz.org</code>) for the public API at about 1 request/second. To go much faster, point it at a mirror you already host — for example <a href="https://github.com/metabrainz/musicbrainz-docker">musicbrainz-docker</a> on <code>http://localhost:5000</code>. This app does not start Docker for you.</p>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label" asp-for="Input.MusicBrainzBaseUrl">Server URL</label>
            <input class="form-control" asp-for="Input.MusicBrainzBaseUrl" placeholder="https://musicbrainz.org" />
            <div class="form-text">Origin of the MusicBrainz website / <code>/ws/2</code> API. <code>localhost:5000</code> is accepted.</div>
        </div>
        <div class="col-md-6">
            <label class="form-label" asp-for="Input.MusicBrainzCoverArtBaseUrl">Cover Art Archive URL</label>
            <input class="form-control" asp-for="Input.MusicBrainzCoverArtBaseUrl" placeholder="https://coverartarchive.org" />
            <div class="form-text">Optional. musicbrainz-docker’s port 5000 is not Cover Art Archive — leave this blank unless you host a CAA mirror.</div>
        </div>
        <div class="col-md-6">
            <label class="form-label" asp-for="Input.MusicBrainzContact">Contact (User-Agent)</label>
            <input class="form-control" asp-for="Input.MusicBrainzContact" />
            <div class="form-text">Required by the public API; still sent to a local mirror.</div>
        </div>
        <div class="col-md-6">
            <label class="form-label" asp-for="Input.MusicBrainzMinIntervalMs">Min interval (ms)</label>
            <input class="form-control" asp-for="Input.MusicBrainzMinIntervalMs" type="number" min="0" placeholder="Auto" />
            <div class="form-text">Blank = auto (1200ms public, 50ms self-hosted). <code>0</code> removes the extra delay. Public Cover Art Archive stays at 1200ms.</div>
        </div>
    </div>

    <h2 class="h5">Workers</h2>
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label class="form-label" asp-for="Input.IncrementalIntervalMinutes">Incremental sync interval (minutes)</label>
            <input class="form-control" asp-for="Input.IncrementalIntervalMinutes" type="number" min="5" />
        </div>
        <div class="col-md-8 d-flex flex-wrap align-items-end gap-4">
            <div class="form-check">
                <input class="form-check-input" asp-for="Input.EnableMusicBrainz" />
                <label class="form-check-label" asp-for="Input.EnableMusicBrainz">MusicBrainz</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" asp-for="Input.EnableLastFmTrackInfo" />
                <label class="form-check-label" asp-for="Input.EnableLastFmTrackInfo">Last.fm track.getInfo</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" asp-for="Input.EnableDiscogs" />
                <label class="form-check-label" asp-for="Input.EnableDiscogs">Discogs</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" asp-for="Input.EnableTheAudioDb" />
                <label class="form-check-label" asp-for="Input.EnableTheAudioDb">TheAudioDB</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" asp-for="Input.EnableVocaDb" />
                <label class="form-check-label" asp-for="Input.EnableVocaDb">VocaDB</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" asp-for="Input.EnableUtaiteDb" />
                <label class="form-check-label" asp-for="Input.EnableUtaiteDb">UtaiteDB</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" asp-for="Input.EnableTouhouDb" />
                <label class="form-check-label" asp-for="Input.EnableTouhouDb">TouhouDB</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" asp-for="Input.SeedSampleData" />
                <label class="form-check-label" asp-for="Input.SeedSampleData">Seed sample scrobbles when empty</label>
            </div>
        </div>
        <div class="form-text">VocaDB, UtaiteDB, and TouhouDB use public APIs (no keys). They fill Japanese vocaloid, utaite, and Touhou metadata when MusicBrainz coverage is thin.</div>
    </div>
    <button class="btn btn-primary" type="submit">Save</button>
</form>

<div class="card card-body mt-4" id="api-keys">
    <h2 class="h5">REST API keys</h2>
    <p class="text-muted">Keys let a mobile app (or anything else) call <a asp-page="/Api">/api/v1</a> with the same features as this site. The full token is shown once at creation — store it on the device. Send it as <code>Authorization: Bearer gmk_…</code> or <code>X-Api-Key</code>.</p>

    @if (Model.CreatedApiKey is not null)
    {
        <div class="alert alert-warning">
            <div class="fw-semibold mb-1">Copy this key for @(Model.CreatedApiKeyName). It will not be shown again.</div>
            <code class="user-select-all d-block text-break">@Model.CreatedApiKey</code>
        </div>
    }

    @if (Model.ApiKeyError is not null)
    {
        <div class="alert alert-danger">@Model.ApiKeyError</div>
    }

    @if (Model.ApiKeys.Count == 0)
    {
        <p class="text-muted mb-3">No active API keys yet.</p>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-sm align-middle mb-0">
                <thead>
                <tr>
                    <th>Name</th>
                    <th>Prefix</th>
                    <th>Scopes</th>
                    <th>Created</th>
                    <th>Last used</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var key in Model.ApiKeys)
                {
                    <tr>
                        <td>@key.Name</td>
                        <td><code>@key.Prefix…</code></td>
                        <td>@string.Join(", ", key.Scopes)</td>
                        <td class="text-nowrap">@key.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</td>
                        <td class="text-nowrap">@(key.LastUsedAt is null ? "never" : key.LastUsedAt.Value.UtcDateTime.ToString("yyyy-MM-dd HH:mm") + " UTC")</td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="RevokeApiKey" class="d-inline" onsubmit="return confirm('Revoke this API key? Apps using it will stop working.');">
                                <input type="hidden" name="id" value="@key.Id" />
                                <button class="btn btn-sm btn-outline-danger" type="submit">Revoke</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    <form method="post" asp-page-handler="CreateApiKey" class="row g-3 align-items-end" autocomplete="off">
        <div class="col-md-5">
            <label class="form-label" asp-for="NewApiKeyName">Key name</label>
            <input class="form-control" asp-for="NewApiKeyName" placeholder="Phone, tablet, …" />
        </div>
        <div class="col-md-4 d-flex flex-wrap gap-3 pb-2">
            <div class="form-check">
                <input class="form-check-input" asp-for="NewApiKeyRead" />
                <label class="form-check-label" asp-for="NewApiKeyRead">Read (analytics &amp; catalog)</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" asp-for="NewApiKeyWrite" />
                <label class="form-check-label" asp-for="NewApiKeyWrite">Write (edits &amp; jobs)</label>
            </div>
        </div>
        <div class="col-md-3">
            <button class="btn btn-outline-primary w-100" type="submit">Create API key</button>
        </div>
    </form>
</div>
