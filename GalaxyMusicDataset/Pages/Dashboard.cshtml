@page
@model DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="h3 mb-1">Overview</h1>
<p class="text-muted">Listening stats for the selected range. All-time numbers sit under each card.</p>

<partial name="_AnalyticsNav" model='"dashboard"' />
<partial name="_TimeRange" model='Model.TimeRangeView("/Dashboard")' />

@if (Model.Overview.ScrobbleCount == 0)
{
    <div class="alert alert-info">No scrobbles in this range. Seed sample data or run a Last.fm sync from <a asp-page="/Index">Progress</a>.</div>
}

<partial name="_StatCards" model="Model.Overview" />

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header">Daily volume</div>
            <div class="card-body">
                @if (Model.Overview.DailyVolume.Count == 0)
                {
                    <div class="text-muted">Nothing to plot.</div>
                }
                else
                {
                    <canvas id="daily-sparkline" height="120" data-chart="sparkline" data-payload="@Model.DailyJson"></canvas>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">Most recent</div>
            <div class="card-body">
                @if (Model.Overview.MostRecent is null)
                {
                    <div class="text-muted">No plays yet.</div>
                }
                else
                {
                    var r = Model.Overview.MostRecent;
                    <div class="fs-5"><a href="@Url.Page("/Tracks", Model.DetailRoute(r.TrackId))">@r.Title</a></div>
                    <div><a href="@Url.Page("/Artists", Model.DetailRoute(r.ArtistId))">@r.ArtistName</a></div>
                    <div class="text-muted">@(r.AlbumTitle ?? "No album")</div>
                    <div class="small mt-2">@AnalyticsDisplay.Timestamp(r.PlayedAt)</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Top genres</span>
                <a class="small" asp-page="/Tags" asp-all-route-data="Model.FilterQuery()">All tags</a>
            </div>
            <div class="card-body">
                @if (Model.Tags.Genres.Count == 0)
                {
                    <div class="text-muted">No genre tags in this range yet. MusicBrainz, Discogs, and TheAudioDB fill these in during enrichment.</div>
                }
                else
                {
                    <canvas id="genre-donut" height="180" data-chart="genres" data-payload="@Model.GenreJson"></canvas>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header">Most played tags</div>
            <div class="card-body">
                @if (Model.Tags.Tags.Count == 0)
                {
                    <div class="text-muted">Crowd tags from Last.fm and the other sources show up here.</div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var tag in Model.Tags.Tags.Take(16))
                        {
                            var routes = Model.FilterQuery(new Dictionary<string, string?> { ["name"] = tag.Name });
                            <a class="badge rounded-pill tag-pill" asp-page="/Tags" asp-all-route-data="routes">
                                @tag.Name <span class="text-muted">@AnalyticsDisplay.Count(tag.Plays)</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/analytics.js" asp-append-version="true"></script>
}
